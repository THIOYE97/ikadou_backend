{
  "name": "ikadou-backend",
  "version": "1.0.0",
  "description": "Ikadou — Backend API (terrains Mali diaspora)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "render:predeploy": "npm run db:migrate && npm run db:seed",
    "prod": "NODE_ENV=production node src/server.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.9.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^7.2.0",
    "express-validator": "^7.0.1",
    "firebase-admin": "^10.3.0",
    "google-auth-library": "^10.6.2",
    "handlebars": "^4.7.8",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.4",
    "pg": "^8.11.5",
    "sharp": "^0.33.4",
    "stripe": "^21.0.1",
    "twilio": "^5.1.0",
    "uuid": "^9.0.1",
